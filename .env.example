# Copy to .env (gitignored) or export in your shell. Without a key everything runs offline.
GEMINI_API_KEY=
# Optional overrides (by default the newest stable Gemini Flash model the key can access is chosen)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# DSA_OFFLINE=1        # force the offline path even when a key is set
